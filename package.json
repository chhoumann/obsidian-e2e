{
  "name": "obsidian-e2e",
  "version": "0.15.0",
  "description": "Vitest-first end-to-end test utilities for Obsidian plugins.",
  "homepage": "https://github.com/chhoumann/obsidian-e2e#readme",
  "bugs": {
    "url": "https://github.com/chhoumann/obsidian-e2e/issues"
  },
  "license": "MIT",
  "author": "Christian B. B. Houmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhoumann/obsidian-e2e.git"
  },
  "bin": {
    "obsidian-e2e": "dist/runner/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "default": "./dist/vitest.mjs"
    },
    "./matchers": {
      "types": "./dist/matchers.d.mts",
      "default": "./dist/matchers.mjs"
    },
    "./runner": {
      "types": "./dist/runner/index.d.mts",
      "default": "./dist/runner/index.mjs"
    },
    "./capture": {
      "types": "./dist/capture/index.d.mts",
      "default": "./dist/capture/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "changeset": "changeset",
    "dev": "vp pack --watch",
    "release": "npm stage publish --provenance",
    "release:check": "vp check && vp test && vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
